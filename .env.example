# ==========================================================
# Mnema Talk - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# NEVER commit your actual .env file to version control!
# ==========================================================

# Server Network Settings
PORT=8080
BIND_ADDR=0.0.0.0
APP_ENV=production
PUBLIC_URL=https://chat.example.com

# Security & Secrets (generate a random 32+ byte string in production)
JWT_SECRET=replace_with_a_secure_random_string_in_production
SESSION_EXPIRY_HOURS=720

# Admin Account Configuration
ADMIN_USERNAME=Herzog
ADMIN_INITIAL_PASSWORD=change_this_password_immediately

# Data Storage Paths
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# WebRTC SFU Port Range (UDP for voice & 4K 60fps video traffic)
WEBRTC_UDP_PORT_MIN=50000
WEBRTC_UDP_PORT_MAX=50050
# If behind NAT, provide the external/public IP or domain
WEBRTC_NAT_1TO1_IP=

# Legal & Privacy Policy Configuration (Art. 13 DSGVO)
# Keeps the public repository generic; set your actual operator details in your local .env
LEGAL_OPERATOR_NAME=Community Operator
LEGAL_OPERATOR_EMAIL=admin@example.com
LEGAL_OPERATOR_COUNTRY=Deutschland
LEGAL_PROJECT_NOTICE=Privates, nicht-kommerzielles Projekt
