{
  "name": "mnema-talk-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:app && vite build",
    "preview": "vite preview",
    "test": "npm run test:tooling && vitest run",
    "test:coverage": "npm run test:tooling && vitest run --coverage && npm run coverage:check",
    "lint": "node scripts/lint.ts && node scripts/check-tailwind.ts && npm run i18n:check",
    "i18n:check": "node scripts/check-i18n.ts --strict",
    "check": "npm run lint && npm run contracts:check && npm run typecheck && npm run test:coverage && npm run build",
    "typecheck": "npm run typecheck:source && vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.worklet.json",
    "contracts:check": "node scripts/generate-contracts.ts --check && node scripts/check-event-registry.ts",
    "typecheck:source": "node scripts/check-typescript.ts --e2e",
    "typecheck:app": "node scripts/check-typescript.ts && vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.worklet.json",
    "test:tooling": "node --test scripts/*.test.ts",
    "coverage:check": "node scripts/check-coverage.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.4.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@tauri-apps/api": "2.12.4",
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "highlight.js": "11.12.0",
    "pinia": "^4.1.0",
    "qrcode-generator": "2.0.4",
    "swagger-ui-dist": "^5.34.0",
    "ts-mls": "1.6.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "jiti": "2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
