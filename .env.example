# ==========================================================
# Mnema Talk - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# PLACEHOLDERS ONLY. NEVER commit your actual .env file!
# All variables are read by internal/config/config.go.
# ==========================================================
# New installation? Use the setup assistant, not this file:
#   docker run --rm -it --user "$(id -u):$(id -g)" -v "$PWD:/out" ghcr.io/msch128/mnema-talk setup
# It asks a few questions, generates every secret and writes a minimal .env and
# docker-compose.yml (doc/quick-start.md). Copying this file by hand is the
# exception (doc/deployment.md, "Fresh install"). Everything not in section 1
# has a default.
#
# CONTENTS
#   1. REQUIRED          the server will not start without these (6 settings)
#   2. Network & voice   ports, reverse proxy, WebRTC, TURN
#   3. E-mail            optional
#   4. Updates & profiles  image tag, "Update now" button, Compose profiles
#   5. Advanced          limits, retention, storage, database, legal text
# ==========================================================

# ==========================================================
# 1. REQUIRED - the server will not start without these
# ==========================================================
# Production refuses the placeholder values below, so change every line in this
# section. If something is missing, the container log lists everything that is
# missing at once and stops (doc/troubleshooting-voice.md).

# REQUIRED: the address members type into their browser, with https://.
# Example: https://chat.example.com
# Allowed origins, Secure cookies (https://), the links in e-mails and invites
# and the voice address all follow from it unless set explicitly later.
PUBLIC_URL=https://chat.example.com

# REQUIRED secret: signs sessions. At least 32 characters.
# Generate: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_string_in_production

# REQUIRED secret: the database password (docker compose builds DATABASE_URL
# from POSTGRES_*). Generate: openssl rand -hex 16
POSTGRES_PASSWORD=replace_with_a_random_database_password

# REQUIRED: the credentials of the media storage (SeaweedFS in compose).
# Any letters and digits; the secret needs at least 8 characters.
# Example: S3_ACCESS_KEY=mnema   Generate the secret: openssl rand -hex 16
S3_ACCESS_KEY=replace_with_access_key
S3_SECRET_KEY=replace_with_secret_key

# REQUIRED on the first start: the Owner's first password, at least 14
# characters. Generate: openssl rand -base64 18
# It only creates the account when none exists yet; sign in, then delete this
# line. (In development an empty value generates a password and prints it once
# in the server log.)
ADMIN_INITIAL_PASSWORD=

# Also decide now (they have defaults, used only on the very first start):
# Only used on first start when no admin exists. Required in production (the
# first start fails without it); in development an empty value generates a
# random password and prints it once in the server log. Change it after the
# first login, then you can remove it here.
ADMIN_USERNAME=admin
# Language of the default categories and channels on a brand-new installation:
# en (default) or de. Only used on the very first start; nothing is renamed later.
INITIAL_LANGUAGE=en

# ==========================================================
# 2. Network & voice
# ==========================================================
# Chat goes through your reverse proxy (HTTPS, WebSocket); voice and video use
# the UDP ports below directly (doc/quick-start.md, doc/ports.md).

PORT=8080

# docker compose only: host address the app port is published on. Loopback by
# default (put a reverse proxy in front); 0.0.0.0 exposes it to the network.
# PUBLISH_ADDR=127.0.0.1

# Comma-separated CIDRs/IPs whose X-Forwarded-For header is trusted (your
# reverse proxy). Only these may tell the app the real client IP, which rate
# limiting and the login lockout rely on.
# Empty = loopback only (127.0.0.0/8,::1/128): a proxy on the same host when
# the app runs outside Docker.
# docker compose: requests through Docker's published port or from a proxy
# container arrive from the Docker bridge, not from loopback. Set this to your
# proxy's address (its container IP, the bridge gateway for a proxy on the
# same host, or its LAN address), e.g. TRUSTED_PROXY_CIDRS=192.168.0.20.
# Setups: Caddy/nginx on the compose host -> the bridge gateway (see
# `docker network inspect <project>_default`); proxy container on the same
# Docker network -> its container IP or that network's subnet; proxy on another
# host -> its address (and PUBLISH_ADDR=<LAN address>). Empty with a proxy in
# front means all clients share one rate-limit identity (the app logs a warning).
# Never list a whole private range: every host in it could forge its IP.
# Production and staging refuse to start when an entry is wider than an IPv4
# /24 or an IPv6 /64 and the listener is not loopback. A /24, a single proxy
# address, and any range on a loopback listener still start.
TRUSTED_PROXY_CIDRS=

# Comma-separated origins allowed for API/WebSocket requests.
# Empty = PUBLIC_URL only. For the Vite dev server add http://localhost:3000,
# e.g. CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# This UDP range must be published by Docker and forwarded by your router/firewall.
WEBRTC_UDP_PORT_MIN=50000
WEBRTC_UDP_PORT_MAX=50050

# The one UDP port all media peers share. Empty = WEBRTC_UDP_PORT_MIN; any
# port inside MIN/MAX works (Docker publishes that range). 0 = the old mode
# where every peer takes its own port(s) from the range: then the default 51
# ports allow only about 25 people in calls at once across all rooms.
# Requires app restart. Per-room member limits are set per voice channel by
# the admin, not here (default: no limit).
WEBRTC_UDP_MUX_PORT=

# Addresses browsers send voice/video to, comma-separated: IPs or host names
# (a dynamic-DNS name is re-resolved every 5 minutes). Behind a home router
# list the public address AND the server's LAN IP, so members on the internet
# and in the LAN both connect, e.g. "myhome.example.org,192.168.0.10".
# Empty (the default): in production the server finds its public IPv4 address
# at startup with a STUN request (see WEBRTC_AUTO_ANNOUNCE) and logs it; an IPv4
# address in PUBLIC_URL is announced as well. Set this to pin it or when members
# in the LAN need the LAN address too. If nothing is found and WEBRTC_TURN_URLS is
# empty, a warning is logged: browsers then get the container's own address and
# calls from outside the host fail.
WEBRTC_NAT_1TO1_IP=
# This host's address in your own network (e.g. 192.168.1.20), comma-separated
# for several. With WEBRTC_NAT_1TO1_IP empty it is announced after the
# automatically found public address, so members at home reach voice although
# the router cannot loop back to its own public address (NAT loopback). A
# program inside a Docker container cannot see the host's LAN address, which is
# why you set it here (the setup assistant does, when it knows it); outside a
# container the server uses its own private address automatically.
# WEBRTC_LAN_IP=

# true (default): look the public address up as described above. The only
# request is one STUN binding request from the server to the servers below, which
# see the server's IP address; listed in the privacy policy while active.
# false = no request; set WEBRTC_NAT_1TO1_IP instead.
WEBRTC_AUTO_ANNOUNCE=true

# STUN servers the server asks for its own public address (comma-separated,
# host:port). Default: stun.l.google.com:19302,stun.cloudflare.com:3478. Not the
# STUN servers browsers use (WEBRTC_STUN_URLS).
# WEBRTC_DETECT_STUN_URLS=
# Optional comma-separated STUN servers (e.g. stun:stun.example.com:3478).
# Empty = no third-party STUN; usually not needed when WEBRTC_NAT_1TO1_IP is set.
# If you set one, it is listed automatically in the privacy policy.
WEBRTC_STUN_URLS=

# TURN relay built into the app, for members whose network blocks the UDP range
# (strict firewalls, some VPNs): they reach voice through one port instead.
#   auto (default): runs while WEBRTC_TURN_URLS below is empty, stays off once
#                   you configure an external TURN server
#   on:             always runs; with WEBRTC_TURN_URLS set too, members are
#                   offered both servers
#   off:            never runs
# Forward the port (UDP and TCP) in your router. If it cannot be bound the
# server keeps running without it and Admin > System shows a warning. The relay
# only forwards to the voice server itself, never anywhere else. Browsers are
# told PUBLIC_URL's host name. Docker publishes the port on all addresses;
# TURN_PUBLISH_ADDR limits that. The default 3479 stays clear of coturn's 3478; to
# keep Docker from publishing it at all set TURN_PUBLISH_ADDR=127.0.0.1, see
# doc/operations.md#built-in-turn-relay.
WEBRTC_BUILTIN_TURN=auto
WEBRTC_BUILTIN_TURN_PORT=3479
# Host name members are told to reach the relay at; empty = the host of
# PUBLIC_URL. Set it when that name only forwards HTTP (a CDN or tunnel).
WEBRTC_BUILTIN_TURN_HOST=

#TURN_PUBLISH_ADDR=0.0.0.0
# Address Docker publishes the voice UDP range on (default 0.0.0.0). 127.0.0.1
# keeps voice on this computer, for a trial; the setup assistant's --local sets it.
#WEBRTC_PUBLISH_ADDR=0.0.0.0
# Optional external TURN relay for friends behind strict NATs or firewalls that block
# the UDP port range, e.g. a coturn container with "use-auth-secret" and
# "static-auth-secret=<WEBRTC_TURN_SECRET>". Clients get credentials valid for
# 12 h; the secret itself never leaves the server. Listed in the privacy policy.
#   WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# List a ?transport=tcp URL: some browsers (e.g. Opera with its VPN or WebRTC
# protection on) may not use UDP at all and only connect through TURN over TCP.
# Start coturn with: docker compose --profile turn up -d (realm below).
WEBRTC_TURN_URLS=
WEBRTC_TURN_SECRET=
WEBRTC_TURN_REALM=


# ==========================================================
# 3. E-mail (optional)
# ==========================================================

# Without SMTP_HOST the server sends no e-mail and everything works as before.
# With it, members can confirm an optional e-mail address and reset a forgotten
# password by mail. Test it under Admin > System ("Send test mail").
# SMTP_TLS: starttls (default, port 587) | tls (implicit TLS, port 465) | none
# (no encryption; refused in production and with credentials).
# The password can also come from a file: SMTP_PASSWORD_FILE=/run/secrets/smtp
# (mount it into the container; set only one of the two). Nothing is stored in
# the database or in backups of it.
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
# Sender, e.g. Mnema Talk <noreply@example.org>. Required with SMTP_HOST.
SMTP_FROM=

# ==========================================================
# 4. Updates & optional parts (Compose profiles)
# ==========================================================
# A Compose profile is an optional group of services that starts only when you
# enable it. Enable profiles here (COMPOSE_PROFILES=a,b; this also works in the
# Synology Container Manager) or per command (docker compose --profile x up -d).
#   autoupdate  the "Update now" button: updater + recreator. Needs UPDATER_TOKEN (32+ characters).
#   turn        an external coturn TURN server. Needs WEBRTC_TURN_URLS and a WEBRTC_TURN_SECRET of 16+ characters.
# The setup assistant can enable autoupdate for you. Details: doc/updating.md and
# doc/operations.md.

# COMPOSE_PROFILES=autoupdate

# Image the app container runs. Default mnema-talk:local = built on this host
# (docker compose up -d --build); self-update can't pull that. For released
# images use e.g. ghcr.io/msch128/mnema-talk:X.Y (follows the patch releases of
# one minor line; a new minor needs a manual tag change; see the releases page
# for the current X.Y) or :latest (follows everything). A full version (:X.Y.Z)
# or digest pins the image: then the
# admin UI only shows the manual update command.
MNEMA_IMAGE=mnema-talk:local

# Optional self-update from the admin UI through the updater sidecar
# (docker compose --profile autoupdate up -d). OFF while empty. The sidecar
# holds the Docker socket (= root on the host) and only accepts requests with
# this token; generate it with: openssl rand -hex 32 (min. 32 characters).
UPDATER_TOKEN=
# Where the app reaches the sidecar (internal compose network only).
UPDATER_URL=http://mnema-updater:8080
# The sidecar checks every new image's cosign signature and build provenance
# against this project's release workflow before it pulls or restarts anything.
# Only a fork that publishes its own signed images changes these (empty = the
# official images); the pattern must be anchored with ^ and $.
# UPDATER_IMAGE_REPOSITORY=ghcr.io/example/mnema-talk
# UPDATER_CERT_IDENTITY_REGEXP=^https://github\.com/example/mnema-talk/\.github/workflows/release\.yml@refs/heads/main$
# UPDATER_CERT_ISSUER=https://token.actions.githubusercontent.com
# UPDATER_SOURCE_URL=https://github.com/example/mnema-talk

# The server asks GitHub every 30 minutes for the latest release of
# msch128/mnema-talk (api.github.com, unauthenticated, conditional requests)
# and shows the result to admins in the System tab. GitHub sees the server's
# IP address; no user data is sent. Listed in the privacy policy while on.
# "false" = no outbound request at all.
UPDATE_CHECK_ENABLED=true

# ==========================================================
# 5. Advanced - leave alone unless a guide or the Status tab says so
# ==========================================================

# Listen address. Empty = 127.0.0.1 with APP_ENV=development or test (anything else is
# refused there), 0.0.0.0 otherwise. Fixed inside the compose container.
BIND_ADDR=

# --- Server mode ---
# production | staging | development | test ("prod"/"dev" are accepted aliases).
# production and staging enforce a strong JWT_SECRET and S3 credentials;
# development and test relax these checks for local work. Other values are rejected.
APP_ENV=production

# --- Sessions ---
# Session lifetime in hours (1-8760).
SESSION_EXPIRY_HOURS=720

# --- PostgreSQL ---
# docker compose builds DATABASE_URL for the app container from POSTGRES_*.
POSTGRES_USER=mnema
POSTGRES_DB=mnema_talk
# DEV ONLY: loopback host port from docker-compose.dev.yml (`make dev`).
POSTGRES_HOST_PORT=5432
# Only needed when running the server OUTSIDE compose (go run / make dev):
DATABASE_URL=postgres://mnema:replace_with_a_random_database_password@localhost:5432/mnema_talk?sslmode=disable

# --- S3 object storage (SeaweedFS in compose, or any S3-compatible service) ---
# Compose sets S3_ENDPOINT=http://seaweedfs:8333 for the app container.
# Outside compose (make dev) the server uses this endpoint.
S3_ENDPOINT=http://localhost:8333
# DEV ONLY: loopback host port from docker-compose.dev.yml (`make dev`).
S3_HOST_PORT=8333
S3_REGION=us-east-1
S3_BUCKET=mnema-media
S3_FORCE_PATH_STYLE=true

# --- Media, features, logging and retention ---
# Hard ceiling for a single upload in MB (1-2048) and the initial limit. The
# Owner can lower it in the app (globally and per role), never above this.
# A reverse proxy in front must allow at least this body size.
MAX_UPLOAD_SIZE_MB=50
# Custom emoji the community may hold (0-2000, default 200; 0 = no new ones).
EMOJI_MAX=200
# Upload bytes one account (member, bot, webhook) may add per rolling 24 hours
# (MB, 0 = off). Deleted files still count.
UPLOAD_QUOTA_MB_PER_DAY=2048
# Pause all uploads once stored media reaches this size (MB, 0 = no cap), and
# while the filesystem at MEDIA_DISK_PATH (a volume the app can see) has less
# than MEDIA_MIN_FREE_MB free. MEDIA_DISK_PATH empty = no free-space check.
MEDIA_MAX_TOTAL_MB=0
MEDIA_MIN_FREE_MB=1024
MEDIA_DISK_PATH=
# Booleans (LINK_PREVIEWS_ENABLED, API_DOCS_ENABLED, S3_FORCE_PATH_STYLE)
# accept true/false (also 1/0); anything else is rejected at startup.
# Link cards: the server fetches title, description and image of public web
# pages linked in chat (never private/internal addresses). The linked sites
# then see the server's IP instead of the readers'. "false" turns it off.
LINK_PREVIEWS_ENABLED=true
# Outgoing webhooks may only contact public addresses. To let one reach a
# service on your own network, list its address or range here, comma
# separated (for example 192.168.1.20 or 10.0.0.0/24). Anyone who may manage
# webhooks can then make this server send requests to those addresses, so
# list only what you must. Cloud metadata addresses stay blocked. Empty = off.
WEBHOOK_ALLOW_PRIVATE_TARGETS=
# Web Push: members can get notifications on their devices while Mnema Talk is
# closed. The server creates its own VAPID key on first start and keeps it in
# the database (so it is in your backups). Pushes are encrypted for the
# member's browser; the browser vendor's push service cannot read them. The
# server only ever connects to the push address a browser gave it, and only to
# public addresses. "false" turns push off entirely.
PUSH_ENABLED=true
# user = each member decides whether a push carries the start of the message
# (default); off = pushes never carry message text, for everyone.
PUSH_PREVIEWS=user
# Contact in the VAPID header that push services may use to reach you: an
# https:// URL or a mailto: address. Empty = PUBLIC_URL when it is https.
PUSH_VAPID_SUBJECT=
# API reference for signed-in members: Swagger UI at /api/docs and the
# OpenAPI document at /api/openapi.json. Off by default; "true" turns it on.
API_DOCS_ENABLED=false
# Log level: debug | info | warn | error. Empty = info in production, debug
# otherwise; "debug" adds voice connection details such as the addresses
# browsers offer (for troubleshooting). Other values are rejected.
LOG_LEVEL=
# Automatic deletion of old media. 0 = NEVER delete automatically (default).
# A positive number deletes media older than that many days.
MEDIA_RETENTION_DAYS=0
# Automatic deletion of old audit log entries. 0 = keep forever (default).
# The log holds deleted and edited message text and Talk presence history; see
# SECURITY.md and doc/moderation.md before choosing a value.
AUDIT_RETENTION_DAYS=0
# Automatic deletion of the kept earlier versions of edited messages (members
# with Manage messages can read them). 0 = keep (default; at most 50 per message).
EDIT_HISTORY_RETENTION_DAYS=0

# --- Monitoring ---
# Prometheus metrics at GET /api/metrics, scraped with
# "Authorization: Bearer <METRICS_TOKEN>". Empty = endpoint disabled (404).
# Generate with: openssl rand -hex 32
# Metrics, scrape config and example alert rules: doc/operations.md
# ("Monitoring and alerts"). The admin System tab needs no token.
METRICS_TOKEN=
# Go pprof profiles for finding what a loaded server spends CPU and memory on.
# Empty = off (default). Only a loopback address is accepted (for example
# 127.0.0.1:6060); inside the container, reach it with
# "docker compose exec app wget -qO- http://127.0.0.1:6060/debug/pprof/heap".
PPROF_ADDR=

# --- Voice upload limit ---
# The upload (Mbit/s) your connection can carry for calls. 0 = no limit
# (default). Above 0 the server keeps the media it sends under about 85% of it
# by moving viewers on "Auto" quality down to smaller camera and screen layers,
# biggest streams first, and lets them back up below about 70%. Audio is never
# touched; a viewer who picked a quality is not moved. Doc: operations.md.
VOICE_UPLOAD_LIMIT_MBIT=0

# --- Clock check ---
# true (default): compare the server clock with an NTP server (time.cloudflare.com,
# pool.ntp.org) every 6 hours for the admin Status tab's setup checks. The NTP
# server sees the server's IP address; listed in the privacy policy while on.
# false = no request.
CLOCK_CHECK_ENABLED=true

# --- Container resources (docker compose only, not read by the app) ---
# Memory caps per container. Uploads stream to S3 in 5 MB parts, so the app
# needs about 5 MB per upload in flight, whatever MAX_UPLOAD_SIZE_MB is.
# APP_TMP_SIZE is the app's small RAM-backed /tmp.
APP_MEM_LIMIT=1g
APP_TMP_SIZE=64m
POSTGRES_MEM_LIMIT=1g
SEAWEEDFS_MEM_LIMIT=1g

# --- Legal & privacy policy (Art. 13 GDPR / DSGVO) ---
# Keep the public repository generic; set your real operator details in .env only.
LEGAL_OPERATOR_NAME=Community Operator
LEGAL_OPERATOR_EMAIL=admin@example.com
# Empty: the legal page shows a translated default (Germany, private non-commercial project).
LEGAL_OPERATOR_COUNTRY=
LEGAL_PROJECT_NOTICE=
