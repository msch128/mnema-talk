{
  "name": "mnema-talk-sdk",
  "version": "0.0.0-dev",
  "description": "Official TypeScript SDK for Mnema Talk bots: REST API, gateway, slash commands, components and modals.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msch128/mnema-talk.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/msch128/mnema-talk/tree/main/sdk/typescript#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-timeout=20000 \"test/**/*.test.ts\"",
    "test:contract": "node --test --test-timeout=60000 \"test/contract/*.test.ts\"",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
