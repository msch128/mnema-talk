# ==========================================================
# Mnema Talk - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# NEVER commit your actual .env file to version control!
# ==========================================================

# Server Network Settings
PORT=8080
BIND_ADDR=0.0.0.0
APP_ENV=production
PUBLIC_URL=https://chat.example.com

# Security & Secrets
# Generate with: openssl rand -hex 32  (min. 32 characters, required in production)
JWT_SECRET=replace_with_a_secure_random_string_in_production
SESSION_EXPIRY_HOURS=720

# Admin Account Configuration
# Only used on first start when no admin exists. Leave empty to have a random
# password generated and printed once in the server log. Change it after login.
ADMIN_USERNAME=Herzog
ADMIN_INITIAL_PASSWORD=

# PostgreSQL (docker-compose builds DATABASE_URL from these)
POSTGRES_USER=mnema
POSTGRES_PASSWORD=replace_with_a_random_database_password
POSTGRES_DB=mnema_talk

# S3 Object Storage (SeaweedFS locally, or R2 / S3 / B2)
S3_REGION=us-east-1
S3_BUCKET=mnema-media
S3_ACCESS_KEY=replace_with_access_key
S3_SECRET_KEY=replace_with_secret_key
MEDIA_RETENTION_DAYS=30

# WebRTC SFU Port Range (UDP for voice & 4K 60fps video traffic)
WEBRTC_UDP_PORT_MIN=50000
WEBRTC_UDP_PORT_MAX=50050
# If behind NAT, provide the external/public IP or domain
WEBRTC_NAT_1TO1_IP=
# Optional comma-separated STUN servers (e.g. stun:stun.example.com:3478).
# Empty = no third-party STUN; usually not needed when WEBRTC_NAT_1TO1_IP is set.
# If you set one, it is listed automatically in the privacy policy.
WEBRTC_STUN_URLS=

# Legal & Privacy Policy Configuration (Art. 13 DSGVO)
# Keeps the public repository generic; set your actual operator details in your local .env
LEGAL_OPERATOR_NAME=Community Operator
LEGAL_OPERATOR_EMAIL=admin@example.com
LEGAL_OPERATOR_COUNTRY=Deutschland
LEGAL_PROJECT_NOTICE=Privates, nicht-kommerzielles Projekt
